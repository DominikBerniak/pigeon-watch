<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PigeonWatch.ArchitectureTests</RootNamespace>
    <AssemblyName>PigeonWatch.ArchitectureTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Host\PigeonWatch.WebApi.Host.csproj" />
    <ProjectReference Include="..\WebApi\PigeonWatch.WebApi.csproj" />
    <ProjectReference Include="..\DependencyInjection\PigeonWatch.DependencyInjection.csproj" />
    <ProjectReference Include="..\BusinessLogic\PigeonWatch.BusinessLogic.csproj" />
    <ProjectReference Include="..\Data\PigeonWatch.Data.csproj" />
    <ProjectReference Include="..\BusinessObjects\PigeonWatch.BusinessObjects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
