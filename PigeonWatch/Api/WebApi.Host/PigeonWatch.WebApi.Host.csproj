<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PigeonWatch.WebApi.Host</RootNamespace>
    <AssemblyName>PigeonWatch.WebApi.Host</AssemblyName>
    <UserSecretsId>17568e6d-4dbf-438e-b9c2-8effd5774136</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi\PigeonWatch.WebApi.csproj" />
    <ProjectReference Include="..\DependencyInjection\PigeonWatch.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
